# OpenAI-compatible LLM provider for the agentic pit-wall strategist.
# Any of these three keys enables cloud LLM radio commentary.
# If none is set, the deterministic rule-based strategist runs instead.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: override provider endpoint/model
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b